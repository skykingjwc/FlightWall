# Local editor and build output
.vscode/
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Firmware signing keys and local secrets
private.pem
*-private.pem
*.key
secrets.*
!secrets.example.*

# Upstream documentation artwork retained in the private source archive. The
# public project links to the maintained upstream HUB75 documentation instead.
/assets/
/docs/UPSTREAM-HUB75-README.md
/docs/HISTORY.md

# Upstream demo artwork/examples not used by either FlightWall build target
/examples/analog_clock.hpp
/examples/antialiased_line.hpp
/examples/grey_scale_stripes.hpp
/examples/hue_value_spectrum.hpp
/examples/matreshka_32x16.h
/examples/pixel_fill.hpp
/examples/rectangle.hpp
/examples/rotator.hpp
/examples/taylor_swift_*.h
/examples/vanessa_mai_64x64.h

# Generated firmware images
*.bin
*.elf
*.hex
*.uf2
*.map

# The stable, signed automatic-update payload is intentionally published.
!update/flightwall.uf2

# OS/editor files
.DS_Store
Thumbs.db
*.swp

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
